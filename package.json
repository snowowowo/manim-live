{
  "name": "manim-live",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "在浏览器里用真 Python 跑 Manim 代码并渲出一幅画面——纯逻辑，零框架、零 DSH",
  "license": "MIT",
  "keywords": [
    "manim",
    "pyodide",
    "animation",
    "math",
    "browser",
    "canvas",
    "three.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manim-live/manim-live.git"
  },
  "homepage": "https://github.com/manim-live/manim-live#readme",
  "bugs": {
    "url": "https://github.com/manim-live/manim-live/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./style.css": "./style.css"
  },
  "files": [
    "dist",
    "style.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --testTimeout=30000",
    "test:net": "MANIM_NET=1 vitest run --testTimeout=300000",
    "coverage": "vitest run --coverage --coverage.provider=v8 --coverage.include='src/**/*.{ts,tsx,js}' --coverage.exclude='src/**/*.test.ts' --coverage.exclude='src/**/*.generated.ts' --testTimeout=30000",
    "playground": "vite --config playground/vite.config.ts",
    "check:playground": "node scripts/check-playground.mjs",
    "setup:assets": "node scripts/setup-assets.mjs",
    "check:pkg": "publint && attw --pack . --profile esm-only --ignore-rules no-resolution",
    "prepublishOnly": "pnpm build && pnpm check:pkg"
  },
  "dependencies": {
    "manim-web": "^0.3.24"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.3",
    "playwright": "^1.64.0",
    "publint": "^0.3.15",
    "tsdown": "^0.22.2",
    "typescript": "^7.0.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.3"
  }
}
